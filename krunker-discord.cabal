cabal-version:      3.0
name:               krunker-discord
version:            0.1.0.0
-- synopsis:
-- description:
homepage:           krunker.io
license:            BSD-3-Clause
license-file:       LICENSE
author:             Glen Sargent
maintainer:         glen@frvr.com
-- copyright:
category:           Game
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall

executable krunker-discord
    import:           warnings
    main-is:          Main.hs
    other-modules:    Discord.Types
                    , Discord.State
                    , Discord.Gateway
    build-depends:    base
                    , wuss
                    , websockets
                    , aeson
                    , text
                    , bytestring
                    , http-client
                    , http-client-tls
                    , stm
                    , async
    hs-source-dirs:   src
    default-language: Haskell2010
